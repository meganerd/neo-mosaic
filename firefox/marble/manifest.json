{
  "manifest_version": 2,
  "name": "neo-mosaic (Marble)",
  "version": "1.0.0",
  "author": "Gustin Johnson",
  "homepage_url": "https://gitlab.zarquon.space/meganerd/neo-mosaic",
  "description": "NCSA Mosaic-inspired retro theme — marble variant with cool blue-grey stone texture, raised Motif/Windows 3.1 chrome, and geometric diamond logo.",
  "browser_specific_settings": {
    "gecko": {
      "id": "neo-mosaic-marble@zarquon.space"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "theme": {
    "images": {
      "theme_frame": "marble-header.png"
    },
    "colors": {
      "frame": "#E0E2EA",
      "frame_inactive": "#D0D2D8",
      "tab_background_text": "#000000",
      "tab_text": "#000000",
      "tab_line": "#000080",
      "tab_loading": "#000080",
      "tab_selected": "#EAECF2",
      "toolbar": "#E0E2EA",
      "toolbar_text": "#000000",
      "toolbar_top_separator": "#646870",
      "toolbar_bottom_separator": "#646870",
      "toolbar_vertical_separator": "#646870",
      "bookmark_text": "#000080",
      "infobar": "#E0E2EA",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#000000",
      "toolbar_field_border": "#A8ACB4",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#000000",
      "toolbar_field_border_focus": "#000080",
      "toolbar_field_highlight": "#000080",
      "toolbar_field_highlight_text": "#FFFFFF",
      "button_background_hover": "#D4D6DE",
      "button_background_active": "#C8CAD2",
      "popup": "#E0E2EA",
      "popup_text": "#000000",
      "popup_border": "#A8ACB4",
      "popup_highlight": "#000080",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#E0E2EA",
      "sidebar_text": "#000000",
      "sidebar_border": "#A8ACB4",
      "sidebar_highlight": "#000080",
      "sidebar_highlight_text": "#FFFFFF",
      "ntp_background": "#F0F2F8",
      "ntp_text": "#000000",
      "ntp_card_background": "#F5F6FA",
      "ntp_card_text": "#000000"
    }
  }
}
