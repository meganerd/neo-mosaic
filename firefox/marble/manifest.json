{
  "manifest_version": 2,
  "name": "neo-mosaic (Marble)",
  "version": "1.0.0",
  "author": "Gustin Johnson",
  "homepage_url": "https://gitlab.zarquon.space/meganerd/neo-mosaic",
  "description": "NCSA Mosaic-inspired retro theme — marble variant with classic 90s web stone texture, Motif/Windows 3.1 grey chrome, and geometric diamond logo.",
  "browser_specific_settings": {
    "gecko": {
      "id": "neo-mosaic-marble@zarquon.space"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "theme": {
    "images": {
      "theme_frame": "marble-header.png"
    },
    "colors": {
      "frame": "#D2C8BE",
      "frame_inactive": "#B8B0A8",
      "tab_background_text": "#000000",
      "tab_text": "#000000",
      "tab_line": "#000080",
      "tab_loading": "#000080",
      "tab_selected": "#E0D6CC",
      "toolbar": "#D2C8BE",
      "toolbar_text": "#000000",
      "toolbar_top_separator": "#A09890",
      "toolbar_bottom_separator": "#A09890",
      "toolbar_vertical_separator": "#A09890",
      "bookmark_text": "#000080",
      "infobar": "#D2C8BE",
      "toolbar_field": "#F0EAE0",
      "toolbar_field_text": "#000000",
      "toolbar_field_border": "#A09890",
      "toolbar_field_focus": "#F0EAE0",
      "toolbar_field_text_focus": "#000000",
      "toolbar_field_border_focus": "#000080",
      "toolbar_field_highlight": "#000080",
      "toolbar_field_highlight_text": "#FFFFFF",
      "button_background_hover": "#E0D6CC",
      "button_background_active": "#B8B0A8",
      "popup": "#D2C8BE",
      "popup_text": "#000000",
      "popup_border": "#A09890",
      "popup_highlight": "#000080",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#D2C8BE",
      "sidebar_text": "#000000",
      "sidebar_border": "#A09890",
      "sidebar_highlight": "#000080",
      "sidebar_highlight_text": "#FFFFFF",
      "ntp_background": "#E8E0D6",
      "ntp_text": "#000000",
      "ntp_card_background": "#F0EAE0",
      "ntp_card_text": "#000000"
    }
  }
}
