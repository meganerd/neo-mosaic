{
  "manifest_version": 3,
  "name": "neo-mosaic (Globe)",
  "version": "1.0.0",
  "description": "NCSA Mosaic-inspired retro theme (globe variant). Classic 1993 grey chrome with the iconic Mosaic 'M' globe logo.",
  "developer": {
    "name": "Gustin Johnson",
    "url": "https://gitlab.zarquon.space/meganerd/neo-mosaic"
  },
  "icons": {
    "512": "icon_512.png"
  },
  "mod": {
    "schema_version": 1,
    "payload": {
      "theme": {
        "dark": {
          "gx_accent": {
            "h": 250,
            "s": 62,
            "l": 55
          },
          "gx_secondary_base": {
            "h": 250,
            "s": 30,
            "l": 10
          }
        },
        "light": {
          "gx_accent": {
            "h": 250,
            "s": 62,
            "l": 34
          },
          "gx_secondary_base": {
            "h": 0,
            "s": 0,
            "l": 75
          }
        }
      },
      "wallpaper": {
        "dark": {
          "image": "wallpaper/dark.png",
          "text_color": "#C8C8E8",
          "text_shadow": "#0E0C1E"
        },
        "light": {
          "image": "wallpaper/light.png",
          "text_color": "#000000",
          "text_shadow": "#C0C0C0"
        }
      }
    }
  }
}
